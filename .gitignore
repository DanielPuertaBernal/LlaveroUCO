# Herramientas de sesión/agente locales — no forman parte del proyecto
.claude/
.engram/
.atl/

# Dependencias — pnpm es el gestor del proyecto; un package-lock.json
# conviviendo con pnpm-lock.yaml hace que CI instale un árbol distinto al local.
**/node_modules/
package-lock.json
yarn.lock

# Env / secretos
.env
.env.*
!.env.example

# Build output
**/dist/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Editor/OS
.DS_Store
*.swp

# Coverage / cache
**/coverage/
**/.eslintcache
*.xls
*.xlsx

# Índice local de CodeGraph y store de pnpm
.codegraph/
.pnpm-store/
.gga

# Volcados de base de datos (contienen datos reales)
*.sql
# ...salvo el DDL de esquema versionado como documentacion (sin datos)
!documentacion/**/*.sql
