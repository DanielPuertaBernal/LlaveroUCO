# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo

# ── PostgreSQL ────────────────────────────────────────────────────────────────

PGHOST=localhost
PGPORT=5432
PGDATABASE=nombre_de_tu_base_de_datos
PGUSER=usuario_postgres
PGPASSWORD=password_del_usuario

# ── Office 365 / Azure AD (login) ────────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/callback
OAUTH_STATE_SIGNING_SECRET=
FRONTEND_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth-callback
SUPERADMIN_EMAIL=

# ── CORS (URL del frontend) ───────────────────────────────────────────────────
CLIENT_URL=https://tu-app.vercel.app
VITE_API_URL=http://localhost:8080

# ── Correo (relay SMTP interno UCO) ───────────────────────────────────────────
MAIL_HOST=mail.uco.edu.co
MAIL_HOST_FALLBACK=192.168.10.10
MAIL_PORT=25
MAIL_FROM=no-reply@uco.edu.co

# ── Sync ETL Comunidad (integración servidor-a-servidor) ─────────────────────
COMUNIDAD_SYNC_API_KEY=genera_una_clave_larga_y_aleatoria
# SYNC_RATE_LIMIT_MAX=300