# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo

# ── NFC / ESP32 ───────────────────────────────────────────────────────────────
ESP32_DEVICE_KEY=clave_del_dispositivo_nfc

# ── CORS (URL del frontend en Vercel) ─────────────────────────────────────────
CLIENT_URL=https://tu-app.vercel.app

# ── Correo (Nodemailer + Gmail) ───────────────────────────────────────────────
GMAIL_USER=correo@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT lo asigna Render automáticamente, no lo definas aquí

# PostgreSQL (mongo-postgres-migration)
PGHOST=localhost
PGPORT=5432
PGDATABASE=nombre_de_tu_base_de_datos
PGUSER=usuario_postgres
PGPASSWORD=password_del_usuario

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/callback
OAUTH_STATE_SIGNING_SECRET=
FRONTEND_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth-callback

SUPERADMIN_EMAIL=

PORT=8080
VITE_API_URL=http://localhost:8080

MAIL_HOST=
MAIL_HOST_FALLBACK=
MAIL_PORT=
MAIL_FROM=