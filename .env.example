# -- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=8080

# -- JWT (OBLIGATORIAS: server.js aborta el arranque sin ellas) ---------------
# Genera cada una con: openssl rand -hex 48
JWT_SECRET=CAMBIAR_por_un_secreto_largo_aleatorio
JWT_REFRESH_SECRET=CAMBIAR_por_otro_secreto_largo_aleatorio

# -- PostgreSQL ---------------------------------------------------------------
# PGPORT es el puerto en el HOST. docker-compose publica el contenedor ahi, asi
# que ambos coinciden siempre. Usa 5433 si ya tienes un Postgres del sistema
# ocupando el 5432.
PGHOST=localhost
PGPORT=5433
PGDATABASE=llavero
PGUSER=llavero
PGPASSWORD=CAMBIAR_password_de_desarrollo

# -- Office 365 / Azure AD (login) --------------------------------------------
# auth.oauth.js las lee de forma perezosa: el server arranca sin ellas y solo
# falla en el momento en que se invoca el flujo OAuth. Dejalas vacias si no vas
# a probar el login de Office365.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/callback
OAUTH_STATE_SIGNING_SECRET=CAMBIAR_secreto_para_firmar_el_state_oauth
FRONTEND_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth-callback

# Opcional: crea este usuario como admin al arrancar. Vacia = no hay bootstrap.
SUPERADMIN_EMAIL=

# -- CORS / frontend ----------------------------------------------------------
# CLIENT_URL: origen permitido por CORS en app.js (default http://localhost:5173).
# VITE_API_URL: se inyecta en el bundle del cliente, asi que debe ser una URL
# alcanzable desde el NAVEGADOR, no desde dentro de un contenedor.
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080

# -- Correo (relay SMTP interno UCO) ------------------------------------------
# Solo alcanzable dentro de la red UCO; fuera de ella el envio falla.
MAIL_HOST=mail.uco.edu.co
MAIL_HOST_FALLBACK=172.16.1.6
MAIL_PORT=25
MAIL_FROM=no-reply@uco.edu.co

# -- Sync ETL Comunidad (servidor a servidor) ---------------------------------
# Se espera en el header `X-Api-Key` de las rutas de sync de /api/comunidad.
# Genera con: openssl rand -hex 32
COMUNIDAD_SYNC_API_KEY=CAMBIAR_api_key_de_sync
